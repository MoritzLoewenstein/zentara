# Public origin of the deployed app, used to build absolute URLs
# (OAuth redirect URIs, invite links, etc.). No trailing slash.
ORIGIN=https://example.com
# Public namespace used to prefix downloaded artifacts (e.g. recovery codes file).
# Exposed to the browser via $env/static/public.
PUBLIC_APP_NAMESPACE=zentara

# Polar Flow OAuth client credentials.
# Register an app at https://admin.polaraccesslink.com/
POLARFLOW_CLIENT_ID=
POLARFLOW_CLIENT_SECRET=

# Strava OAuth client credentials.
# Register an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# SQLite database connection string used by Prisma.
DATABASE_URL=file:./data/db.sqlite
