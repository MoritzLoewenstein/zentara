generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id
  email     String   @unique
  password  String
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at")

  invites          UserInvite[]
  recoveryCodes    UserRecoveryCode[]
  sessions         Session[]
  dashboard        Dashboard?
  oauthConnections OAuthConnection[]
  userOptions      UserOption[]
  userRecords      UserRecord[]

  @@map("users")
}

model UserInvite {
  userId    String   @map("user_id")
  token     String   @unique
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@map("user_invites")
}

model UserRecoveryCode {
  userId String @map("user_id")
  code   String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, code])
  @@map("user_recovery_codes")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Dashboard {
  userId String @id @map("user_id")
  config String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dashboards")
}

model OAuthConnection {
  userId              String    @map("user_id")
  provider            String
  oauthState          String?   @map("oauth_state")
  accessToken         String?   @map("access_token")
  refreshToken        String?   @map("refresh_token")
  expiresAt           DateTime? @map("expires_at")
  externalAccountId   String?   @map("external_account_id")
  externalAccountInfo Json?     @map("external_account_info")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, provider])
  @@unique([provider, externalAccountId])
  @@map("oauth_connections")
}

model Option {
  key   String @unique
  value Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model UserOption {
  userId String @map("user_id")
  key    String
  value  Json?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, key])
}

model UserRecord {
  id         String  @id @default(cuid())
  externalId String? @map("external_id")
  userId     String  @map("user_id")
  recordType String  @map("record_type")
  value      Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recordType, externalId])
  @@index([userId, recordType])
}
