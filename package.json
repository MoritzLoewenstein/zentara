{
	"name": "server-dashboard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prisma:generate": "prisma generate",
		"prisma:studio": "prisma studio",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold=error",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint:fix": "prettier --write . && eslint . --fix",
		"lint": "prettier --check . && eslint .",
		"test": "vitest --run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"start:prod": "prisma migrate deploy && node build"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/better-sqlite3": "^7.6.13",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^26.1.1",
		"@vitest/browser-playwright": "^4.0.6",
		"@vitest/ui": "^4.0.6",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"prettier": "^3.9.6",
		"prettier-plugin-prisma": "^5.0.0",
		"prettier-plugin-svelte": "^3.5.2",
		"prisma": "^7.9.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^7.3.6",
		"vitest": "^4.0.6",
		"vitest-browser-svelte": "^2.2.1"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "^7.9.0",
		"@prisma/client": "^7.9.0",
		"argon2": "^0.45.1",
		"better-sqlite3": "^13.0.1",
		"dompurify": "^3.4.12",
		"jsdom": "^29.1.1",
		"svgo": "^4.0.2",
		"ulid": "^3.0.2",
		"zod": "^4.4.3"
	},
	"volta": {
		"node": "26.5.0"
	},
	"allowScripts": {
		"better-sqlite3@12.11.1": true,
		"better-sqlite3@13.0.1": true,
		"argon2@0.45.1": true,
		"prisma@7.9.0": true,
		"esbuild@0.28.1": true,
		"@prisma/engines@7.9.0": true
	}
}
