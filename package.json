{
	"name": "server-dashboard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prisma:generate": "prisma generate",
		"prisma:studio": "prisma studio",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold=error",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint:fix": "prettier --write . && eslint . --fix",
		"lint": "prettier --check . && eslint .",
		"test": "vitest --run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"start:prod": "prisma migrate deploy && node build"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/better-sqlite3": "^9.6.0",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.4.0",
		"@vitest/browser-playwright": "^4.0.6",
		"@vitest/ui": "^4.0.6",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-prisma": "^5.0.0",
		"prettier-plugin-svelte": "^3.5.2",
		"prisma": "^7.10.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^7.3.6",
		"vitest": "^4.0.6",
		"vitest-browser-svelte": "^2.2.1"
	},
	"dependencies": {
		"@paralleldrive/cuid2": "^3.3.0",
		"@prisma/adapter-better-sqlite3": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"argon2": "^0.45.1",
		"better-sqlite3": "^13.0.3",
		"dompurify": "^3.4.14",
		"jsdom": "^30.0.1",
		"svgo": "^4.1.0",
		"ulid": "^3.0.2",
		"zod": "^4.5.1"
	},
	"volta": {
		"node": "26.5.0"
	},
	"allowScripts": {
		"better-sqlite3": true,
		"argon2": true,
		"prisma": true,
		"esbuild": true,
		"@prisma/engines": true
	}
}
